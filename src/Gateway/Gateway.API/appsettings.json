{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "marketplace-auth",
    "Audience": "marketplace-api",
    "SigningKey": ""
  },
  "Google": {
    "ClientId": ""
  },
  "Services": {
    "Auth": {
      "BaseUrl": "http://auth-api:8080"
    },
    "Wallet": {
      "BaseUrl": "http://wallet-api:8080"
    },
    "Inventory": {
      "BaseUrl": "http://inventory-api:8080"
    },
    "Marketplace": {
      "BaseUrl": "http://marketplace-api:8080"
    },
    "Admin": {
      "BaseUrl": "http://admin-api:8080"
    }
  },
  "ServiceAuth": {
    "OutgoingKey": ""
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5500",
      "http://127.0.0.1:5500",
      "http://localhost:8080",
      "http://127.0.0.1:8080"
    ]
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 30,
      "WindowSeconds": 60
    },
    "TopUp": {
      "PermitLimit": 20,
      "WindowSeconds": 60
    },
    "Purchase": {
      "PermitLimit": 30,
      "WindowSeconds": 60
    }
  },
  "Gateway": {
    "AuthStatusTimeoutSeconds": 5,
    "InternalHosts": [
      "localhost",
      "127.0.0.1",
      "::1",
      "gateway"
    ]
  }
}