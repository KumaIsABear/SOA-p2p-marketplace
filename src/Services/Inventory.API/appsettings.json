    "Audience": "marketplace-api",
    "SigningKey": ""
  },
  "ServiceAuth": {
    "AllowedCallers": {
      "seeder": {
        "Key": ""
      },
      "marketplace": {
        "Key": ""
      },
      "admin": {
        "Key": ""
      }
    }
  }
