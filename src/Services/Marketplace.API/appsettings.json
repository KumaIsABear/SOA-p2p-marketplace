  "Economy": {
    "FeeBasisPoints": 500,
    "ListingLockTtlSeconds": 20
  },
  "InternalServices": {
    "ServiceKey": "",
    "AuthBaseUrl": "http://auth-api:8080",
    "InventoryBaseUrl": "http://inventory-api:8080",
    "AdminBaseUrl": "http://admin-api:8080",
    "WalletBaseUrl": "http://wallet-api:8080",
    "TimeoutSeconds": 10
  },
  "RabbitMq": {
    "Host": "rabbitmq",
    "Port": 5672,
    "VirtualHost": "marketplace",
    "Username": "marketplace_service",
    "Password": ""
  }
