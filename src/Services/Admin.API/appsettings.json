{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Database": {
    "AutoMigrate": true
  },
  "Seed": {
    "Enabled": false
  },
  "Jwt": {
    "Issuer": "marketplace-auth",
    "Audience": "marketplace-api",
    "SigningKey": ""
  },
  "Redis": {
    "ConnectionString": ""
  },
  "RabbitMq": {
    "Host": "rabbitmq",
    "Port": 5672,
    "VirtualHost": "marketplace",
    "Username": "admin_service",
    "Password": ""
  },
  "Economy": {
    "DefaultBandBps": 2000
  },
  "Analytics": {
    "TimeZoneId": "Asia/Ho_Chi_Minh",
    "DailySummaryTime": "00:00"
  },
  "Services": {
    "Auth": {
      "BaseUrl": "http://auth-api:8080"
    },
    "Wallet": {
      "BaseUrl": "http://wallet-api:8080"
    },
    "Inventory": {
      "BaseUrl": "http://inventory-api:8080"
    },
    "Marketplace": {
      "BaseUrl": "http://marketplace-api:8080"
    },
    "TimeoutSeconds": 5
  },
  "ServiceAuth": {
    "OutgoingKey": "",
    "AllowedCallers": {
      "marketplace": {
        "Key": ""
      }
    }
  }
}
